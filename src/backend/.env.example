# Copy to .env and fill in. Never commit .env.

# --- Supabase (Project Settings -> API Keys; service_role key, not anon) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- API ---
PORT=3001
NODE_ENV=development
# Optional fallback user id when a request sends none
TEST_USER_ID=

# --- Job execution ---
# simulation | github_actions | kubernetes
JOB_EXECUTOR=github_actions
# false = run the worker separately with `npm run worker`
RUN_WORKER=true
WORKER_POLL_INTERVAL=2000
MAX_CONCURRENT_JOBS=3
MAX_JOBS_PER_USER=2
# running jobs without a heartbeat for this long are re-queued (or failed once retries run out)
JOB_STALE_SECONDS=60

# --- Intent parsing (Hugging Face Inference) ---
HF_API_KEY=
HF_MODEL=facebook/bart-large-mnli
# chosen on the dev split by `npm run eval:intents`
CONFIDENCE_THRESHOLD=0.4
HF_TIMEOUT_MS=8000

# --- GitHub ---
# Fallback repo/token when the extension doesn't send one (the extension normally
# sends the open workspace's repo and the VS Code GitHub sign-in token)
GH_REPO_OWNER=
GH_REPO_NAME=
GH_WORKFLOW_FILE=devcommandhub.yml
# Fine-grained PAT: Actions read/write, Contents read-only
GITHUB_API_KEY=
# Optional: key for encrypting users' GitHub tokens at rest (defaults to one derived from SUPABASE_SERVICE_KEY)
DCH_TOKEN_KEY=
